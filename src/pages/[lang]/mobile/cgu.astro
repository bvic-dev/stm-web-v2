---
import { getEntry, render } from 'astro:content';
import Legal from '../../../components/mobile/legal.astro';
import { generateLangStaticPaths } from '../../../utils/locale';

const { lang } = Astro.params;

export function getStaticPaths() {
  return generateLangStaticPaths();
}

const entry = await getEntry('legal', `${lang}/mobile/cgu`);
const { Content } = await render(entry!);
---

<Legal entry={entry!} Content={Content} currentLocale={lang!}/>
